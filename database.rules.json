{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists()))",
        ".validate": "newData.hasChildren(['email', 'role', 'createdAt'])",
        "email": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "role": {
          ".validate": "newData.val() === 'Customer'"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": false
        },
        "requestedRole": {
          ".validate": "newData.val() === 'Customer' || newData.val() === 'Restaurant' || newData.val() === 'Courier' || newData.val() === 'Operator'"
        },
        "restaurantName": {
          ".validate": "newData.isString() && ((newData.parent().child('requestedRole').val() === 'Restaurant' && newData.val().length <= 80) || (newData.parent().child('requestedRole').val() !== 'Restaurant' && newData.val() === ''))"
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['displayName', 'phone', 'deliveryAddress', 'vehicle'])",
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "deliveryAddress": { ".validate": "newData.isString() && newData.val().length <= 160" },
        "vehicle": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "$other": { ".validate": false }
      }
    },
    "restaurants": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && (root.child('accountRegistrations').child(auth.uid).child('role').val() === 'RESTAURANT' || root.child('users').child(auth.uid).child('role').val() === 'Restaurant') && newData.child('ownerId').val() === 'firebase:' + auth.uid && (!data.exists() || data.child('ownerId').val() === newData.child('ownerId').val())",
        ".validate": "newData.hasChildren(['ownerId', 'name', 'x', 'y', 'status'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "x": {
          ".validate": "newData.isNumber()"
        },
        "y": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.val() === 'OPEN' || newData.val() === 'PAUSED' || newData.val() === 'CLOSED'"
        }
      }
    },
    "accountRegistrations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['role', 'restaurantName'])",
        "role": {
          ".validate": "newData.val() === 'CUSTOMER' || newData.val() === 'RESTAURANT' || newData.val() === 'COURIER' || newData.val() === 'OPERATOR'"
        },
        "restaurantName": {
          ".validate": "newData.isString() && ((newData.parent().child('role').val() === 'RESTAURANT' && newData.val().length <= 80) || (newData.parent().child('role').val() !== 'RESTAURANT' && newData.val() === ''))"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
