{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists()))",
        ".validate": "newData.hasChildren(['email', 'role', 'createdAt'])",
        "email": { ".validate": "newData.isString() && newData.val() === auth.token.email" },
        "role": { ".validate": "newData.val() === 'Customer' || newData.val() === 'Restaurant' || newData.val() === 'Courier' || newData.val() === 'Operator'" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() === now" },
        "$other": { ".validate": false }
      }
    },
    "restaurants": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'Restaurant' && newData.child('ownerId').val() === 'firebase:' + auth.uid && (!data.exists() || data.child('ownerId').val() === newData.child('ownerId').val())",
        ".validate": "newData.hasChildren(['ownerId', 'name', 'x', 'y', 'status'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "x": { ".validate": "newData.isNumber()" },
        "y": { ".validate": "newData.isNumber()" },
        "status": { ".validate": "newData.val() === 'OPEN' || newData.val() === 'PAUSED' || newData.val() === 'CLOSED'" }
      }
    }
  }
}
