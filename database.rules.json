{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['email', 'role', 'createdAt'])",
        "email": { ".validate": "newData.isString() && newData.val() === auth.token.email" },
        "role": { ".validate": "newData.val() === 'Customer'" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() === now" },
        "$other": { ".validate": false }
      }
    }
  }
}
